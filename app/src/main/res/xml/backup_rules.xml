<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android 12 Auto Backup rules. allowBackup is also false.
  Every domain is excluded so health data and identity fields cannot be
  copied if a device ignores allowBackup. path="." means the whole domain.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
